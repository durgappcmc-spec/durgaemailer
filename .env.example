# ==== LLM + Search (single provider now) ====
GEMINI_API_KEY=AIza_your_key_here
GEMINI_MODEL=gemini-3.6-flash

# ==== Prospect Providers ====
APOLLO_API_KEY=your_apollo_key
ZOOMINFO_USERNAME=
ZOOMINFO_PASSWORD=
# Preferred: paste JWT/API bearer once (avoids re-auth). Username/password still work.
ZOOMINFO_API_KEY=
# Optional PKI auth (private key file + client id)
ZOOMINFO_CLIENT_ID=
ZOOMINFO_PRIVATE_KEY_PATH=./credentials/zoominfo.txt
ROCKETREACH_API_KEY=your_rr_key

# ==== Gmail ====
GMAIL_CLIENT_SECRETS=./credentials/gmail_oauth.json
GMAIL_TOKEN_PATH=./credentials/gmail_token.json
GMAIL_FROM_EMAIL=csr@karunamedia.org
# Optional always-CC (comma-separated). Chat can also say: cc alice@x.com
GMAIL_DEFAULT_CC=

# ==== Sheet / Drive database ====
GOOGLE_SHEET_ID=your_sheet_id_from_url
# Sheets OAuth token (spreadsheets + drive.file scope) — seeds Sends if Apps Script web app is stale
BOOTSTRAP_TOKEN_PATH=./credentials/bootstrap_token.json
# BOOTSTRAP_TOKEN_JSON=
# Pin the Google Drive folder that stores relay_prospects.json / relay_chat.json /
# relay_memory.json so Render redeploys keep the same contacts + chat memory.
# Find it in Drive → Relay Memory folder → URL .../folders/<THIS_ID>
# RELAY_DRIVE_FOLDER_ID=

# ==== Scheduling + Tracking backends ====
APPS_SCRIPT_TRACKING_URL=
TRACKING_BASE_URL=

# ==== Storage ====
CHROMA_DIR=./data/chroma

# ==== Auto sync (no manual inbox extract / save-to-memory) ====
AUTO_SYNC_GMAIL=true
AUTO_SYNC_INTERVAL_MINUTES=30
AUTO_SYNC_GMAIL_DAYS=30
AUTO_SYNC_MAX_PER=75
AUTO_INGEST_PROSPECTS=true

# ==== App login (Streamlit UI) ====
# Local: set APP_REQUIRE_LOGIN=false (or leave username/password blank) to skip login.
# Cloud: set APP_REQUIRE_LOGIN=true and real credentials.
APP_REQUIRE_LOGIN=false
APP_USERNAME=
APP_PASSWORD=
